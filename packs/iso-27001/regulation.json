  "namespaces": [
    {
      "name": "ISO27001",
      "comment": "ISO 27001 control-to-evidence register (ISO/IEC 27001:2022 Annex A, ISO-001/002/003). Each entry maps one Annex A control (from the closed catalog, projected into core.allowed-values) to its implementing evidence \u2014 a reused POLICY, an ADR, or an `evidence_link`. ISO 27001 introduces no statutory document namespace of its own; the control-to-evidence mapping is its sole artifact, reusing POLICY/RISK/VULN from the security base. Path-claim with an `id` so an audit or a cross-ref can resolve a control. core.calendar-freshness over `review_date` surfaces a stale control. The Statement of Applicability's applicable/not-applicable decision rides the control `status`: a `not-applicable` control is out of scope. iso27001.control-evidence (ISO-002) reuses the shared conditional-evidence machinery: an in-scope control asserting an Annex A control with neither a POLICY/ADR cross-ref nor a non-empty `evidence_link` fails.",
      "paths": [
        "docs/compliance/iso-27001/controls/**"
      ],
      "rules": [
        "core.frontmatter",
        "core.id",
        "core.id-unique",
        "core.cross-ref",
        "core.required-metadata",
        "core.allowed-values",
        "core.calendar-freshness",
        "iso27001.control-evidence"
      ],
      "required_metadata": [
        "id",
        "title",
        "status",
        "control",
        "owner",
        "theme",
        "review_date"
      ],
      "allowed_values": [
        "control",
        "theme"
      ],
      "calendar_freshness": {
        "field": "review_date",
        "stale_days": 365
      },
      "control_evidence": {
        "rule": "iso27001.control-evidence",
        "evidence_fields": [
          "evidence_link"
        ],
        "out_of_scope_status": [
          "not-applicable"
        ]
      }
    }
  ]
}
